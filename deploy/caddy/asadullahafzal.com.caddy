# Appended to /etc/caddy/Caddyfile. Caddy obtains and renews HTTPS certificates automatically.

www.asadullahafzal.com {
	redir https://asadullahafzal.com{uri} permanent
}

asadullahafzal.com {
	encode zstd gzip

	# Fingerprinted build assets never change, so browsers can cache them for a year
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3000
}
